# 복사해서 .env 로 저장하고 값을 채운다(.env 는 git 에 올라가지 않는다)
LINER_API_KEY=
# 선택: 기본 키가 인증·잔액 오류(401/402/403)를 내면 자동으로 쓰는 예비 키
# LINER_API_KEY_fallback=
# 선택: 에이전트 모델(기본 anthropic/claude-haiku-5.5)
# LINER_MODEL=anthropic/claude-haiku-5.5

# 선택: 아래 키는 데이터를 처음부터 다시 만드는 스크립트(scripts/)에만 필요하다. 앱 실행(server/app.py)에는 필요 없다.
# DATA_GO_KR_KEY=
# VWORLD_KEY=
# KAKAO_REST_API_KEY=
